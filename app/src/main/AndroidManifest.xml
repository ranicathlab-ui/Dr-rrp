<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- REST sync (Stage 7) and, later, FCM push both need real network access; the WorkManager
         NetworkType.CONNECTED constraint used for the offline sync queue also relies on
         ACCESS_NETWORK_STATE. TLS-only calls are enforced in RetrofitClient, not here. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Runtime-requested on Android 13+ (see MainActivity) — required there to show any
         notification at all, including the FCM alert pushes DrRrpMessagingService posts. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".DrRrpApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DrRrp">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.DrRrp"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".data.sync.DrRrpMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- WorkManager's default auto-initializer runs (via this ContentProvider) before
             Application.onCreate(), using its own default Configuration — that would silently
             bypass DrRrpApplication's Configuration.Provider (and its DrRrpWorkerFactory, which
             SyncWorker needs to be constructed with a SyncManager at all). Removing it here is
             what makes the app's on-demand WorkManager initialization actually take effect. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>

</manifest>